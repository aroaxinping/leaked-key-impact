# feature-store-sync runtime configuration
ENV=production
LOG_LEVEL=info

# Offline feature store (S3)
FEATURE_BUCKET=fs-offline-store-prod
FEATURE_PREFIX=materialized/v2
AWS_DEFAULT_REGION=eu-west-1
AWS_ACCESS_KEY_ID=__CANARY_ACCESS_KEY_ID__
AWS_SECRET_ACCESS_KEY=__CANARY_SECRET_ACCESS_KEY__

# Online store (Redis)
REDIS_HOST=cache.internal
REDIS_PORT=6379
REDIS_DB=0
FEATURE_TTL_SECONDS=86400
